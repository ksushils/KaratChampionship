# --- Core ---
DATABASE_URL=postgres://karat:karat@localhost:5432/karat
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# "development" | "staging" | "production" — staging/development are noindex (SEO-04)
APP_ENV=development
# Dev only: let Payload push schema without migrations. Use migrations in staging/production.
PAYLOAD_DB_PUSH=true
PAYLOAD_JOBS_AUTORUN=false

# --- Storage ---
MEDIA_DIR=media
PRIVATE_UPLOAD_DIR=private-uploads

# --- Email (LEAD-17/18) --- smtp | log | fail | none
EMAIL_ADAPTER=
EMAIL_FROM=Karat Racing <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Fallback recipient when no routing address is configured in Site Settings
ENQUIRY_FALLBACK_EMAIL=

# --- Cron ---
CRON_SECRET=change-me

# --- Analytics (loaded only after consent) ---
# e.g. Plausible: https://plausible.io/js/script.js  (+ NEXT_PUBLIC_ANALYTICS_DOMAIN)
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Seeding ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
